#!/bin/bash
# [flow] The factory probe's gh stand-in: it logs this call for the probe
# record, then answers it from fixture data or refuses it. It never runs the
# real gh, so nothing it is asked reaches GitHub. Every write it is asked for
# is logged as refused.
~/.pyenv/versions/3.14.7/bin/python3.14 -E ~/synapti-marketplace/plugins/flow/bin/_flow_factory.py shim-log --tool gh --log ~/synapti-marketplace/.flow/factory/evidence/P4-2/control/calls.jsonl --git /opt/homebrew/bin/git --stub -- "$@" || exit 97
exec ~/.pyenv/versions/3.14.7/bin/python3.14 -E ~/synapti-marketplace/plugins/flow/bin/_flow_factory.py gh-stub --fixtures ~/synapti-marketplace/.flow/factory/evidence/P4-2/control/shim/gh-fixtures.json --answers ~/synapti-marketplace/.flow/factory/evidence/P4-2/control/gh-answers.jsonl --jq-bin /usr/bin/jq --git /opt/homebrew/bin/git -- "$@"
