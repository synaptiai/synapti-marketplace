#!/bin/bash
# [flow] Logs this git call for the probe record, then runs the real git.
# A call that cannot be logged is not made, and neither is a GitHub write to
# any repository but the one this run may write to.
~/.local/share/uv/python/cpython-3.14.7-macos-aarch64-none/bin/python3.14 -E ~/synapti-marketplace/plugins/flow/bin/_flow_factory.py shim-log --tool git --log ~/synapti-marketplace/.flow/factory/evidence/P3-2/calls.jsonl --git /opt/homebrew/bin/git --allow-repo danielbentes/flow-factory-sandbox -- "$@" || exit 97
exec /opt/homebrew/bin/git "$@"
