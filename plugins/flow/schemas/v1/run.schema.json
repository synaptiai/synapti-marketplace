{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapti.ai/schemas/flow/v1/run.schema.json",
  "title": "FlowRun",
  "description": "One execution attempt of a FlowWorkflow against a target (issue, PR, ad-hoc goal). Provides local auditability and resumability — NOT exactly-once execution or deterministic replay. M3 writes run.yaml; M1 schema fixes the contract so future writers conform.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "context", "state"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "flow.synapti.ai/v1"
    },
    "kind": {
      "const": "FlowRun"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "workflow", "created_at"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}Z-[a-z0-9-]+$",
          "description": "Run identifier — ISO-8601-compact timestamp + target slug (e.g., '2026-05-20T143000Z-issue-42')."
        },
        "workflow": {
          "type": "string",
          "description": "Workflow definition this run executes (e.g., 'start-issue', 'review-pr'). M4 fills these out."
        },
        "workflow_version": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "goal": {
          "type": ["string", "null"],
          "description": "FlowGoal id this run is associated with."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["repo", "branch"],
      "additionalProperties": true,
      "properties": {
        "repo": { "type": "string" },
        "branch": { "type": "string" },
        "issue": { "type": ["integer", "null"], "minimum": 1 },
        "pr": { "type": ["integer", "null"], "minimum": 1 },
        "journal": { "type": "string" }
      }
    },
    "state": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": true,
      "properties": {
        "status": {
          "enum": ["active", "completed", "blocked", "cancelled"]
        },
        "current_phase": { "type": "string" },
        "current_activity": { "type": "string" },
        "completed_activities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered list of activity IDs that have transitioned to a terminal status. Drives /flow:resume."
        },
        "blocked_reason": {
          "type": ["string", "null"]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1 },
        "max_runtime_minutes": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "events": {
      "type": "array",
      "description": "Inlined event summary. High-volume events go to .flow/runs/<id>/events.jsonl instead; this array is for top-level lifecycle moments.",
      "items": {
        "type": "object",
        "required": ["at", "type"],
        "additionalProperties": true,
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "type": { "type": "string" },
          "activity": { "type": "string" }
        }
      }
    }
  }
}
