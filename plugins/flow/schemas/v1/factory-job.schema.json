{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapti.ai/schemas/flow/v1/factory-job.schema.json",
  "title": "FlowFactoryJob",
  "description": "One factory job: an issue's way through the state table. Written only by the factory engine, under the job lock, to <factory dir>/jobs/issue-<N>/job.json. The engine checks it with bin/_flow_factory_schema.py, which supports only the keywords this file uses.",
  "type": "object",
  "required": [
    "apiVersion", "kind", "key", "issue", "state", "attempt", "stage_launches", "sessions",
    "holds_slot", "directive", "cost", "created_at", "updated_at", "vouch_at"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "flow.synapti.ai/v1" },
    "kind": { "const": "FlowFactoryJob" },
    "key": {
      "description": "The job key, issue-<N>-j<seq>.",
      "type": "string",
      "pattern": "^issue-[1-9][0-9]*-j[1-9][0-9]*$"
    },
    "issue": { "type": "integer", "minimum": 1 },
    "state": { "$ref": "#/$defs/state" },
    "attempt": {
      "description": "Failed runs of the current stage; reset to 0 when the job enters a different stage.",
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "stage_launches": {
      "description": "Launches made so far, per stage.",
      "$ref": "#/$defs/per_stage_count"
    },
    "sessions": {
      "description": "The worker session id recorded for each stage.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intake": { "type": "string" },
        "prepare": { "type": "string" },
        "spec": { "type": "string" },
        "build": { "type": "string" },
        "open_pr": { "type": "string" },
        "gate": { "type": "string" },
        "review": { "type": "string" },
        "rework": { "type": "string" },
        "sync": { "type": "string" },
        "resolve": { "type": "string" },
        "approve": { "type": "string" },
        "merging": { "type": "string" }
      }
    },
    "holds_slot": { "type": "boolean" },
    "directive": {
      "description": "The current directive id, or null.",
      "type": ["string", "null"],
      "pattern": "^issue-[1-9][0-9]*-j[1-9][0-9]*-(intake|prepare|spec|build|open_pr|gate|review|rework|sync|resolve|approve|merging)-[1-9][0-9]*$"
    },
    "cost": {
      "type": "object",
      "required": ["usd_total", "runs", "stage_usd", "dearest_turn_usd"],
      "additionalProperties": false,
      "properties": {
        "usd_total": { "type": "number", "minimum": 0 },
        "runs": { "type": "array", "items": { "$ref": "#/$defs/charge" } },
        "stage_usd": { "$ref": "#/$defs/per_stage_usd" },
        "dearest_turn_usd": {
          "description": "The dearest single assistant turn seen in this job; the overshoot allowance is twice it, at least 0.50.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "created_at": { "$ref": "#/$defs/utc" },
    "updated_at": { "$ref": "#/$defs/utc" },
    "vouch_at": { "$ref": "#/$defs/utc_or_null" },
    "base": { "type": ["string", "null"] },
    "branch": {
      "type": ["string", "null"],
      "pattern": "^feature/issue-[1-9][0-9]*-"
    },
    "goal_id": {
      "type": ["string", "null"],
      "pattern": "^issue-[1-9][0-9]*(-f[1-9][0-9]*)?$"
    },
    "worktree": {
      "description": "The absolute path of the job clone.",
      "type": ["string", "null"],
      "pattern": "^/"
    },
    "io_dir": {
      "description": "The absolute path of the folder holding in/ and out/.",
      "type": ["string", "null"],
      "pattern": "^/"
    },
    "pr": { "type": ["integer", "null"], "minimum": 1 },
    "head_sha": { "type": ["string", "null"] },
    "resume_state": { "$ref": "#/$defs/state_or_null" },
    "blocked_stage": { "$ref": "#/$defs/stage_or_null" },
    "reason": { "type": ["string", "null"] },
    "paused_reason": { "type": ["string", "null"] },
    "round": { "type": ["integer", "null"], "minimum": 0 },
    "round_limit": { "type": ["integer", "null"], "minimum": 0 },
    "intake_round": { "type": ["integer", "null"], "minimum": 0 },
    "spec_round": { "type": ["integer", "null"], "minimum": 0 },
    "baseline_digest": { "type": ["string", "null"] },
    "baseline_pending": { "type": ["boolean", "null"] },
    "issue_digest": { "type": ["string", "null"] },
    "build_started": { "type": ["boolean", "null"] },
    "pending_changes": {
      "description": "Fact names a github_change reported that no row has applied yet.",
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "orphan_groups": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["pgid", "start", "stage", "recorded_at"],
        "additionalProperties": false,
        "properties": {
          "pgid": { "type": "integer", "minimum": 1 },
          "start": {
            "description": "The group leader's start time as LC_ALL=C ps -o lstart= prints it, outer white space removed.",
            "type": "string"
          },
          "stage": { "$ref": "#/$defs/stage" },
          "recorded_at": { "$ref": "#/$defs/utc" }
        }
      }
    },
    "snapshots": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["ref", "k", "reason", "at"],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^refs/flow-factory/issue-[1-9][0-9]*/snapshot-[1-9][0-9]*$"
          },
          "k": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string" },
          "at": { "$ref": "#/$defs/utc" }
        }
      }
    },
    "last_session_total": {
      "description": "Session id to the total_cost_usd its last result event reported.",
      "type": ["object", "null"],
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "relaunch": {
      "description": "Set by an applied row that relaunches; read when the next directive is created.",
      "type": ["object", "null"],
      "required": ["cause_row", "mode"],
      "additionalProperties": false,
      "properties": {
        "cause_row": { "type": "string" },
        "mode": { "type": "string" }
      }
    },
    "lease_grace": { "$ref": "#/$defs/utc_or_null" },
    "vouch_event_id": {
      "description": "The id of the issue event that added the queue label, the vouch the job was created from.",
      "type": ["integer", "null"],
      "minimum": 1
    },
    "write_seq": {
      "description": "The largest k used in this job's intent ids issue-N-j<seq>-<row>-<k>; the next intent takes one more than the larger of this and the k of every item in the outbox folder.",
      "type": ["integer", "null"],
      "minimum": 0
    },
    "revouched_replies": {
      "description": "Untrusted comment replies a trusted person vouched for: comment id to the sha256 of the comment body at that moment. The keys are comment ids; the writer checks them, since this validator has no propertyNames.",
      "type": ["object", "null"],
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "intake_inputs": {
      "description": "The comment ids and needs-info answers the intake judge's accepted result rested on.",
      "type": ["object", "null"],
      "required": ["comments", "answers"],
      "additionalProperties": false,
      "properties": {
        "comments": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "answers": { "type": "array", "items": { "$ref": "#/$defs/question_id" } }
      }
    },
    "intake": {
      "description": "What the intake judge accepted the issue with.",
      "type": ["object", "null"],
      "required": ["risk", "surfaces", "scope"],
      "additionalProperties": false,
      "properties": {
        "risk": { "type": "string" },
        "surfaces": { "type": "array", "items": { "type": "string" } },
        "scope": { "type": "string" }
      }
    },
    "needs_info": {
      "description": "The current needs-info round and every earlier round of the job, in order. Replaced only when the intake judge asks again.",
      "type": ["object", "null"],
      "required": ["asked_at", "questions", "round", "earlier"],
      "additionalProperties": false,
      "properties": {
        "asked_at": { "$ref": "#/$defs/utc" },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question_id" } },
        "round": { "type": "integer", "minimum": 1 },
        "earlier": { "type": "array", "items": { "$ref": "#/$defs/needs_info_round" } }
      }
    },
    "commands_seen": {
      "description": "Ids of the /flow-factory comment commands already read for this job.",
      "type": ["array", "null"],
      "items": { "type": "integer", "minimum": 1 }
    },
    "pending_keys": {
      "description": "The tier keys that resolved to confirm when the job parked with reason tier_confirm.",
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/tier_key" }
    },
    "pending_intent": {
      "description": "The blocking write the job waits on in waiting_operator: its outbox item id, kind and tier keys.",
      "type": ["object", "null"],
      "required": ["id", "kind", "key"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/intent_id" },
        "kind": {
          "type": "string",
          "enum": ["comment", "label_add", "label_remove", "assign_label", "pr_close"]
        },
        "key": { "type": "array", "items": { "$ref": "#/$defs/tier_key" } }
      }
    },
    "held_result": {
      "description": "The event the job parked on, stored as a pending event without raised_at, replayed once the pending intent is released.",
      "type": ["object", "null"],
      "required": ["event", "args", "channel", "caller", "facts"],
      "additionalProperties": false,
      "properties": {
        "event": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "args": {
          "description": "The event's arguments; their keys depend on the event.",
          "type": "object"
        },
        "channel": {
          "type": "string",
          "pattern": "^(terminal|launcher|session:.+|comment:[0-9]+)$"
        },
        "caller": {
          "type": "object",
          "required": ["pid", "start", "ancestry"],
          "additionalProperties": false,
          "properties": {
            "pid": { "type": "integer", "minimum": 1 },
            "start": { "type": "string" },
            "ancestry": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
          }
        },
        "facts": {
          "description": "The facts the raising process computed, by name.",
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "confirmed_intent": {
      "description": "The id of the pending intent a release ran or found, kept until the held event is replayed.",
      "type": ["string", "null"],
      "pattern": "^issue-[0-9]+-j[0-9]+-[0-9a-z]+-[0-9]+$"
    },
    "sync_seen": {
      "description": "The sha256 of the sync result the last pass that evaluated github_change saw.",
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "priority_high": {
      "description": "Whether the issue carried the priority label at the last completed sync.",
      "type": ["boolean", "null"]
    },
    "labels_set": {
      "description": "Label names the engine added to the issue and has not removed.",
      "type": ["array", "null"],
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "question_id": {
      "type": "string",
      "pattern": "^NI-[0-9]+$"
    },
    "intent_id": {
      "description": "A job's intent id, issue-N-j<seq>-<row>-<k>; the outbox item schema's job_intent_id.",
      "type": "string",
      "pattern": "^issue-[0-9]+-j[0-9]+-[0-9a-z]+-[0-9]+$"
    },
    "tier_key": {
      "description": "The keys of tiers in the settings schema.",
      "type": "string",
      "enum": ["push", "prCreate", "issueAssign", "issueCreate", "issueUpdate", "merge", "release"]
    },
    "needs_info_round": {
      "type": "object",
      "required": ["asked_at", "questions", "round"],
      "additionalProperties": false,
      "properties": {
        "asked_at": { "$ref": "#/$defs/utc" },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question_id" } },
        "round": { "type": "integer", "minimum": 1 }
      }
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "utc_or_null": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "state": {
      "description": "The keys of states in references/factory-transitions.json.",
      "type": "string",
      "enum": [
        "approve", "build", "cancelled", "gate", "intake", "merged", "merging", "needs_human", "needs_info",
        "needs_spec_approval", "open_pr", "prepare", "queued", "ready", "rejected", "resolve", "review",
        "rework", "spec", "sync", "waiting_ci", "waiting_operator"
      ]
    },
    "state_or_null": {
      "type": ["string", "null"],
      "enum": [
        "approve", "build", "cancelled", "gate", "intake", "merged", "merging", "needs_human", "needs_info",
        "needs_spec_approval", "open_pr", "prepare", "queued", "ready", "rejected", "resolve", "review",
        "rework", "spec", "sync", "waiting_ci", "waiting_operator", null
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "intake", "prepare", "spec", "build", "open_pr", "gate", "review", "rework", "sync", "resolve",
        "approve", "merging"
      ]
    },
    "stage_or_null": {
      "type": ["string", "null"],
      "enum": [
        "intake", "prepare", "spec", "build", "open_pr", "gate", "review", "rework", "sync", "resolve",
        "approve", "merging", null
      ]
    },
    "per_stage_count": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intake": { "type": "integer", "minimum": 0 },
        "prepare": { "type": "integer", "minimum": 0 },
        "spec": { "type": "integer", "minimum": 0 },
        "build": { "type": "integer", "minimum": 0 },
        "open_pr": { "type": "integer", "minimum": 0 },
        "gate": { "type": "integer", "minimum": 0 },
        "review": { "type": "integer", "minimum": 0 },
        "rework": { "type": "integer", "minimum": 0 },
        "sync": { "type": "integer", "minimum": 0 },
        "resolve": { "type": "integer", "minimum": 0 },
        "approve": { "type": "integer", "minimum": 0 },
        "merging": { "type": "integer", "minimum": 0 }
      }
    },
    "per_stage_usd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intake": { "type": "number", "minimum": 0 },
        "prepare": { "type": "number", "minimum": 0 },
        "spec": { "type": "number", "minimum": 0 },
        "build": { "type": "number", "minimum": 0 },
        "open_pr": { "type": "number", "minimum": 0 },
        "gate": { "type": "number", "minimum": 0 },
        "review": { "type": "number", "minimum": 0 },
        "rework": { "type": "number", "minimum": 0 },
        "sync": { "type": "number", "minimum": 0 },
        "resolve": { "type": "number", "minimum": 0 },
        "approve": { "type": "number", "minimum": 0 },
        "merging": { "type": "number", "minimum": 0 }
      }
    },
    "charge": {
      "description": "One charged run: what charge_run returned, with the directive and session.",
      "type": "object",
      "required": ["directive", "session_id", "charged_usd", "basis", "total_cost_usd", "since_last_usd"],
      "additionalProperties": false,
      "properties": {
        "directive": {
          "type": "string",
          "pattern": "^issue-[1-9][0-9]*-j[1-9][0-9]*-(intake|prepare|spec|build|open_pr|gate|review|rework|sync|resolve|approve|merging)-[1-9][0-9]*$"
        },
        "session_id": { "type": ["string", "null"] },
        "charged_usd": { "type": "number", "minimum": 0 },
        "basis": { "enum": ["since_last", "session_increase", "first_total", "limit_plus_turn"] },
        "total_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "since_last_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
