{
  "agentTeams": false,
  "tiers": {
    "push": "journal",
    "prCreate": "journal",
    "issueAssign": "journal",
    "issueCreate": "journal",
    "merge": "confirm",
    "release": "confirm"
  },
  "timeouts": {
    "devServerStartup": 30,
    "e2eTest": 120,
    "qualityCheckMaxIterations": 3,
    "teammateTimeout": 300
  },
  "conventions": {
    "commitTypes": ["feat", "fix", "docs", "style", "refactor", "test", "chore", "perf", "ci", "build", "revert", "improve"],
    "branchPatterns": {
      "feature": "feature/issue-{N}-{desc}",
      "fix": "fix/issue-{N}-{desc}",
      "docs": "docs/issue-{N}-{desc}"
    }
  },
  "merge": {
    "strategy": "squash",
    "deleteBranch": true
  },
  "conflictResolution": {
    "autoResolveTrivial": true,
    "maxConflictFiles": 20
  },
  "release": {
    "tagPrefix": "v"
  },
  "learning": {
    "enabled": true,
    "proposalDir": "~/.claude/flow-proposals"
  },
  "journal": {
    "dir": ".decisions",
    "sensitivityDefault": "public"
  },
  "specFirst": {
    "requireAcceptanceCriteria": true,
    "allowSpecFreeLabels": ["documentation", "chore"]
  },
  "verdict": {
    "enabled": true,
    "requireAllPass": false
  },
  "testing": {
    "tddMode": "suggest"
  },
  "debugging": {
    "maxHypotheses": 3
  },
  "reviewCycleLimit": 3,
  "fixForwardMaxIterations": 2,
  "closedLoop": {
    "enabled": true,
    "maxBuildIterations": 5,
    "maxServerRetries": 3,
    "maxDebugIterations": 5,
    "requireRuntimeVerification": true
  },
  "lsp": {
    "enabled": true,
    "timeout": 5000,
    "diagnosticsAsQuality": true
  },
  "visualVerification": {
    "enabled": true,
    "screenshotDir": ".screenshots",
    "viewports": [
      { "name": "desktop", "width": 1280, "height": 720 },
      { "name": "tablet", "width": 768, "height": 1024 },
      { "name": "mobile", "width": 375, "height": 812 }
    ],
    "maxIterations": 3,
    "requireVisualVerification": false
  }
}
