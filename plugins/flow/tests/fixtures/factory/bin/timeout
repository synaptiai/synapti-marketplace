#!/bin/bash
# The part of coreutils timeout(1) the factory probe runner uses, for machines
# without coreutils: `timeout [--kill-after=N] DURATION COMMAND...`. Sends TERM
# after DURATION and KILL N seconds later; exits 124 when the time ran out,
# otherwise with the command's own status.
if [ "${1:-}" = --version ]; then
  printf '%s\n' "timeout (GNU coreutils) 9.5"
  exit 0
fi
kill_after=""
case "${1:-}" in
  --kill-after=*) kill_after=${1#--kill-after=}; shift ;;
esac
duration=$1; shift
flag=$(mktemp "${TMPDIR:-/tmp}/fixture-timeout.XXXXXX") || exit 125
rm -f "$flag"
# An explicit <&0: a background command's stdin is otherwise /dev/null.
"$@" <&0 &
child=$!
(
  sleep "$duration"
  : > "$flag"
  kill -TERM "$child" 2>/dev/null
  if [ -n "$kill_after" ]; then
    sleep "$kill_after"
    kill -KILL "$child" 2>/dev/null
  fi
) > /dev/null 2>&1 &
watcher=$!
wait "$child"
rc=$?
kill "$watcher" 2>/dev/null
if [ -e "$flag" ]; then
  rm -f "$flag"
  exit 124
fi
exit "$rc"
