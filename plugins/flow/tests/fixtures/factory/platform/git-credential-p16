#!/bin/bash
# A git credential helper for the factory's P16 scenarios, standing in for
# osxkeychain: `get` answers with the password in git-credential-password
# beside it, unless the stand-in sandbox (claude_platform.py) denies reading
# ~/Library/Keychains, when it answers nothing.
here=$(cd "$(dirname "$0")" && pwd)
[ "${1:-}" = get ] || exit 0
cat > /dev/null
IFS=:
for e in ${FIXTURE_SANDBOX_DENY_READ:-}; do
  case "$HOME/Library/Keychains" in "$e"|"$e"/*)
    [ -n "${FIXTURE_SANDBOX_VIOLATIONS:-}" ] && printf 'file-read-data %s\n' "$HOME/Library/Keychains" >> "$FIXTURE_SANDBOX_VIOLATIONS"
    exit 0 ;;
  esac
done
unset IFS
printf 'username=probe\npassword=%s\n' "$(cat "$here/git-credential-password")"
