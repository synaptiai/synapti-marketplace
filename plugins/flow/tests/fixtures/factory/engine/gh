#!/bin/bash
# The factory gh stub: answers the gh calls the factory engine makes, from
# fixture files beside itself. tests/lib/factory-e2e.sh (fe_new) installs it
# over the scenario's $E2E_BIN/gh, and fe_gh writes its fixtures.
#
# It finds everything beside itself, never through E2E_GH or E2E_DIR: it runs
# in the worker's environment, which the launcher builds from nothing.
#
# A call's key is its arguments joined with single spaces, with every / and
# space turned into _: `gh api repos/o/r/pulls/12` is api_repos_o_r_pulls_12.
# The answer is fe-gh/<key>.json beside the stub:
#   hang <seconds>          sleep that long (the stub's own pid sleeps)
#   fail <rc> <stderr text> print the text on stderr and exit rc
#   anything else           printed as it is
# With no fixture and a world file named by FE_WORLD, gh_world.py beside the
# stub answers (its docstring has the world's layout and the calls it knows),
# run by the interpreter fe-gh-python beside the stub names; it exits 86 to
# ask for die_after_post, and the stub then kills its own parent ($PPID, the
# process that ran gh) with SIGKILL. FE_WORLD naming no file exits 98.
# With no fixture and no world, `gh --version` prints gh version 2.101.0
# (2026-09-15), the creation scan of flow-e2e/scratch prints [], `gh api user`
# names the login flow-e2e-engine, and `gh api repos/<owner>/<name>` names
# that repository with default branch main; any other call is logged to
# fe-gh-unhandled.log and exits 99.
#
# Every call is appended to fe-gh-calls.log, and the stub's pid to fe-gh-pids
# before it answers, so a test can check that no stub outlives a timeout.

here=$(cd "$(dirname "$0")" && pwd)
args="$*"
key=${args//\//_}
key=${key// /_}
printf '%s\n' "$args" >> "$here/fe-gh-calls.log"
printf '%s\n' "$$" >> "$here/fe-gh-pids"

fixture="$here/fe-gh/$key.json"
if [ -f "$fixture" ]; then
  IFS= read -r first < "$fixture" || first=""
  case "$first" in
    "hang "*)
      exec sleep "${first#hang }" ;;
    "fail "*)
      rest=${first#fail }
      rc=${rest%% *}
      msg=${rest#"$rc"}
      msg=${msg# }
      printf '%s\n' "$msg" >&2
      exit "$rc" ;;
  esac
  cat "$fixture"
  exit 0
fi

if [ -n "${FE_WORLD:-}" ]; then
  if [ ! -f "$FE_WORLD" ]; then
    printf 'factory gh stub: FE_WORLD names no file: %s\n' "$FE_WORLD" >&2
    exit 98
  fi
  py=$(cat "$here/fe-gh-python" 2>/dev/null)
  [ -n "$py" ] || py=python3
  "$py" -I "$here/gh_world.py" "$FE_WORLD" "$@"
  rc=$?
  if [ "$rc" = 86 ]; then
    # die_after_post: the write is stored; the caller dies before it can
    # record that it was sent.
    [ "$PPID" -gt 1 ] && kill -KILL "$PPID"
    exit 137
  fi
  exit "$rc"
fi

if [ "$#" = 2 ] && [ "$1" = api ]; then
  case "$2" in
    user)
      printf '%s\n' '{"login":"flow-e2e-engine","type":"User"}'
      exit 0 ;;
    repos/*/*/*|repos/*/*\?*) ;;
    repos/?*/?*)
      printf '{"full_name":"%s","name":"%s","owner":{"login":"%s"},"default_branch":"main"}\n' \
        "${2#repos/}" "${2##*/}" "$(printf '%s' "${2#repos/}" | cut -d/ -f1)"
      exit 0 ;;
  esac
fi

case "$key" in
  --version)
    printf '%s\n' "gh version 2.101.0 (2026-09-15)"
    exit 0 ;;
  "api_--paginate_--slurp_repos_flow-e2e_scratch_issues?labels=flow:factory&state=open&per_page=100")
    printf '%s\n' "[]"
    exit 0 ;;
esac

printf '%s\n' "$args" >> "$here/fe-gh-unhandled.log"
printf 'factory gh stub: no fixture fe-gh/%s.json for: gh %s\n' "$key" "$args" >&2
exit 99
