{
  "module": "fourstream",
  "traps": {
    "big_endian_table": {
      "description": "Trap: jump-table lengths written big-endian. Round-trips cleanly; masked when every table length has symmetric bytes (0, 257, 514, ...).",
      "variant": "hidden/traps/big_endian_table.py",
      "discriminating_tests": [
        "test_decode_known_answer",
        "test_encode_known_answer",
        "test_pack_fourth_stream_may_exceed_65535",
        "test_pack_known_answer_distinct_streams",
        "test_pack_length_258_is_little_endian",
        "test_pack_length_five_is_little_endian",
        "test_pack_stream_order_with_equal_lengths",
        "test_unpack_accepts_table_lengths_exactly_filling_block",
        "test_unpack_foreign_block_with_long_fourth_stream",
        "test_unpack_fourth_stream_may_be_empty",
        "test_unpack_known_answer",
        "test_unpack_little_endian_table"
      ]
    },
    "ceil_split": {
      "description": "Trap: segment size (n + 3) // 4 (Zstd's rule) instead of n // 4 with the remainder in stream 4. Round-trips cleanly; masked when len(data) % 4 == 0.",
      "variant": "hidden/traps/ceil_split.py",
      "discriminating_tests": [
        "test_encode_known_answer",
        "test_split_n_plus_three_rule_is_wrong",
        "test_split_preserves_order_of_asymmetric_data",
        "test_split_remainder_goes_to_fourth_stream"
      ]
    },
    "no_reverse": {
      "description": "Trap: stream bodies stored forwards instead of reversed. Round-trips cleanly; masked when every stream is a palindrome.",
      "variant": "hidden/traps/no_reverse.py",
      "discriminating_tests": [
        "test_decode_known_answer",
        "test_encode_known_answer",
        "test_pack_known_answer_distinct_streams",
        "test_pack_reverses_each_stream_not_whole_body",
        "test_unpack_accepts_table_lengths_exactly_filling_block",
        "test_unpack_foreign_block_with_long_fourth_stream",
        "test_unpack_fourth_stream_may_be_empty",
        "test_unpack_known_answer",
        "test_unpack_little_endian_table"
      ]
    },
    "no_validation": {
      "description": "Trap: no input validation \u2014 short data splits into empty streams, oversized streams silently truncate their table entry, and undersized blocks unpack to whatever bytes are present. Masked whenever inputs are well-formed.",
      "variant": "hidden/traps/no_validation.py",
      "discriminating_tests": [
        "test_pack_rejects_first_three_over_65535",
        "test_split_rejects_fewer_than_four_bytes",
        "test_unpack_rejects_block_shorter_than_table",
        "test_unpack_rejects_table_lengths_exceeding_block"
      ]
    },
    "reverse_whole_body": {
      "description": "Trap: the concatenated body is reversed as a whole (s4r s3r s2r s1r) instead of per stream. Round-trips cleanly; masked when s1 == s4 and s2 == s3.",
      "variant": "hidden/traps/reverse_whole_body.py",
      "discriminating_tests": [
        "test_decode_known_answer",
        "test_encode_known_answer",
        "test_pack_known_answer_distinct_streams",
        "test_pack_reverses_each_stream_not_whole_body",
        "test_pack_stream_order_with_equal_lengths",
        "test_unpack_accepts_table_lengths_exactly_filling_block",
        "test_unpack_foreign_block_with_long_fourth_stream",
        "test_unpack_fourth_stream_may_be_empty",
        "test_unpack_known_answer",
        "test_unpack_little_endian_table"
      ]
    },
    "transposed_order": {
      "description": "Trap: streams written and read in the order 4,3,2,1 (jump table still describes 1..3). Round-trips cleanly; masked when all four streams are identical.",
      "variant": "hidden/traps/transposed_order.py",
      "discriminating_tests": [
        "test_decode_known_answer",
        "test_encode_known_answer",
        "test_pack_known_answer_distinct_streams",
        "test_pack_reverses_each_stream_not_whole_body",
        "test_pack_stream_order_with_equal_lengths",
        "test_unpack_accepts_table_lengths_exactly_filling_block",
        "test_unpack_foreign_block_with_long_fourth_stream",
        "test_unpack_fourth_stream_may_be_empty",
        "test_unpack_known_answer",
        "test_unpack_little_endian_table"
      ]
    }
  }
}