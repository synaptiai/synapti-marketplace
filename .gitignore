.DS_Store
.claude.zip
docs/plans/

# Generated Desktop skill packages (attached to releases, not committed)
dist/
.claude/audit.log
.claude/settings.gh-workflow.local.json
.claude/settings.flow.local.json
.claude/agent-memory/
ai-first-kit-workspace/*
.claude/agents/*
.claude/skills/*

# Workshop slide renders (regenerate via Marp from .md sources)
docs/flow-team-session/*.pdf

# Flow v3 runtime state — per-developer; not committed.
# .flow/goals/*.goal.yaml and .flow/workflows/*.workflow.yaml remain
# tracked so teams can share goal contracts and workflow overrides;
# runs/evidence/local-triggers are gitignored to avoid noise.
.flow/runs/
.flow/evidence/
.flow/triggers/*.local.yaml

# Flow decision-journal lockfiles (left by bin/_journal_atomic.py after the
# flock is released), session audit trail, and scheduler lock — all ephemeral
# per-developer runtime state, never committed.
.decisions/*.lock
.flow/goals/*.lock
.trail/
.claude/scheduled_tasks.lock

# Python bytecode caches in plugin bin/ — _journal_atomic.py is imported
# by helper scripts; the .pyc cache is per-developer noise.
plugins/flow/bin/__pycache__/
plugins/flow/**/__pycache__/
.dossier/
.claude/settings.dossier.local.json
.claude/*.lock

# Session detritus from flow runs: a diff dump written by /flow:pr and the
# per-PR handoff note. Both are local working state, not repository content.
.flow_diff_tmp.txt
.handoff-pr*.md

# Per-run dossier scope file. It lives inside the tracked output root but is
# ephemeral run state, and the enforcement hooks key off its mere existence.
**/00-control/.scope.json
